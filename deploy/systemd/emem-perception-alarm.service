[Unit]
# Same shape as emem-witness-alarm: a non-zero exit in journald is a signal
# nobody reads. Put the refusal somewhere a person will actually find it, with
# the exit code, because the four codes mean four different repairs.
Description=emem — record a live_perception probe failure where someone will find it

[Service]
Type=oneshot
ExecStart=/bin/bash -c '{ echo "== $(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ) emem-perception-probe FAILED =="; systemctl show emem-perception-probe -p ExecMainStatus --value | sed "s/^/exit=/"; echo "2=service unreachable 3=registry empty 4=ingester stopped 5=ask unreachable"; journalctl -u emem-perception-probe -n 15 --no-pager -o cat; echo; } >> /var/log/emem-perception-alarm.log'

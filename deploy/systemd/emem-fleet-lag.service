[Unit]
Description=emem — alarm when a research desk this operator vouches for stops writing
After=network-online.target emem-server.service
OnFailure=emem-fleet-lag-alarm.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/emem/scripts/arcade_fleet_lag.py --origin http://127.0.0.1:5051 --min-live 6

[Unit]
# UNSIGNED natural-language layer over emem's signed facts. Calls Bedrock
# directly rather than going through emem-llm-shim: this is the highest-volume
# LLM path and it speaks Converse natively, so the extra hop buys nothing.
# It is not a hard dependency of anything -- if Bedrock is unreachable or the
# credential has expired it degrades to emem's own deterministic answer.
Description=emem "explain" sidecar — UNSIGNED NL layer over signed facts (Bedrock)
After=network-online.target emem-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/emem
# EnvironmentFile=/home/ubuntu/.config/emem/aws.env  # unused: backend is local now
Environment=EMEM_EXPLAIN_BIND=127.0.0.1:5071
Environment=EMEM_EXPLAIN_BACKEND=gemma
Environment=EMEM_EXPLAIN_GEMMA_BASE=http://127.0.0.1:5014
Environment=EMEM_EXPLAIN_GEMMA_MODEL=qwen2.5-1.5b-instruct-q4_k_m
Environment=EMEM_EXPLAIN_MAX_TOKENS=160
# Host path for the container's /data, so the cache survives restarts and is
# visible from inside emem-server as /data/explain_cache.
Environment=EMEM_EXPLAIN_CACHE_DIR=/home/ubuntu/emem/var/emem/explain_cache
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/.emem-witness/venv/bin/python -u /home/ubuntu/emem/python/gemma_explain/explain_sidecar.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

# The channel is a live A2A surface: agents write signed notes around
# the clock, and the server disk-serves web/channel.html, so a bake every
# two minutes keeps the public record at most two minutes behind the
# ledger. One regeneration is ~30 s of same-origin reads; the generator's
# JS syntax gate refuses to write a broken page, so a failed bake keeps
# the previous transcript rather than breaking the route.

[Unit]
Description=emem — two-minute re-bake of the /channel transcript

[Timer]
OnCalendar=*:00/02
Persistent=true
RandomizedDelaySec=15s

[Install]
WantedBy=timers.target

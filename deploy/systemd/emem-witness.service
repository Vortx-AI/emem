[Unit]
Description=emem — co-sign the geo.qa node's log head (federation phase 0)
Documentation=https://emem.dev/docs/federation
# Deliberately NOT ordered after emem-server: a witness that only runs while
# its own node is healthy is not an external witness.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.emem-witness
# Same identity as the OCI box (k572x7go), moved rather than re-minted, so the
# recorded pin chain continues and each run can still prove growth instead of
# reporting "first contact" forever.
Environment=EMEM_PEERS=https://geo.qa/emem
# Custody sampling: a co-signature attests a ROOT, and says nothing about
# whether the peer still holds the leaves under it. Four leaves per tick,
# chosen from the co-signed root and this witness key so the peer cannot know
# them in advance, re-hashed and inclusion-proved. It was 0 here while geo.qa
# audited 4 -- the asymmetric half being the one holding 1.6M facts.
# Verified against the live peer before enabling: sth, inclusion and
# consistency all answer, and a dry run audited 4 leaves clean.
Environment=EMEM_WITNESS_SAMPLES=4
ExecStart=/home/ubuntu/.emem-witness/venv/bin/python /home/ubuntu/.emem-witness/witness_peers.py
Nice=10
IOSchedulingClass=idle

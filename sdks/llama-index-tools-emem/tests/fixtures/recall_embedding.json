  {
   "band": "geotessera",
   "band_metadata": {
    "description": "Tessera annual foundation embedding (128-D, stored upstream as int8 + per-pixel f32 scale; recall decodes to f32 for cosine scoring). A learned multimodal vector that fuses Sentinel-2 optical, Sentinel-1 radar, and seasonality into one position-stable vector per cell per year. The default similarity surface for `/v1/find_similar` because it captures land-cover, structure, and recent change in one shot.",
    "interpretation": "Compare via cosine similarity (or Hamming on the `geotessera.bin128` sign-bit sibling). Two cells with similarity > 0.85 are usually the same physical archetype (e.g. dense urban, mature mangrove, sparse savanna). Not directly interpretable per dimension \u2014 treat as opaque.",
    "pitfalls": "Yearly cadence: a cell that flips from forest to clearing mid-year reads as the *annual mean* until the next vintage. Use `temporal_diff` or `phenology` to detect intra-year change.",
    "provenance": {
     "caution": "model output: a learned representation, not a measurement. Subject to training bias, domain shift, and encoder revision; treat as a hypothesis and corroborate against a deterministic band before load-bearing use.",
     "class": "model_output",
     "deterministic": false,
     "tamper_evidence": "signed_model_checkpoint",
     "trust_rank": 2
    },
    "references": "https://github.com/ucam-eo/tessera",
    "units": "unitless (learned embedding)"
   },

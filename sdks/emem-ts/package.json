{
  "name": "@vortxai/emem",
  "version": "2.3.0",
  "description": "TypeScript client for emem: shared, verifiable memory for AI agents. One address per fact, one signature you can check. No key to read.",
  "license": "Apache-2.0",
  "author": "Vortx AI Private Limited <avijeet@vortx.ai>",
  "homepage": "https://emem.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vortx-AI/emem.git",
    "directory": "sdks/emem-ts"
  },
  "bugs": "https://github.com/Vortx-AI/emem/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent-memory",
    "ai-agents",
    "shared-memory",
    "mcp",
    "model-context-protocol",
    "verifiable",
    "content-addressed",
    "ed25519",
    "provenance",
    "earth-observation",
    "geospatial",
    "satellite"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}

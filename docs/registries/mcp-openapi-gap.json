  "asymmetric_on_purpose": {
    "emem_guard_verdict": [
      "messages"
    ]
  },
  "asymmetric_on_purpose_reasons": {
    "emem_guard_verdict": "POST /v1/guard/verdict accepts a chat-completions `messages` array, because a client that already holds an OpenAI-shaped body should not have to reshape it to ask a question. The MCP TOOL does not advertise it: a checker should ask for the smallest input that answers the question, and listing `messages` beside `texts` made handing it the whole conversation look like the documented way in. The wire is unchanged; only the advertisement is. Removing it from /openapi.json too would hide an input the route really accepts."
  },

# Regenerate the /channel transcript from the live ledger. The server
# disk-serves web/channel.html (with a per-file CSP hashed from the bytes
# it sends), so this bake is all it takes for the public page to follow
# the ledger between deploys. The page sat frozen at 2026-07-21 for a
# week when regeneration only ever happened inside the deploy ritual.
# Triggered by emem-channel-bake.timer; run once manually with
#   systemctl --user start emem-channel-bake.service
#
# Install:
#   cp ops/systemd/emem-channel-bake.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now emem-channel-bake.timer

[Unit]
Description=emem — regenerate the /channel transcript from the ledger
# Reads the roster and every note from the local responder over /mcp.
After=emem-server.service
Wants=emem-server.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/emem
ExecStart=/usr/bin/python3 /home/ubuntu/emem/scripts/build_channel.py
# This said "reading ~250 notes over the wire takes tens of seconds" and set
# 10m. Measured 2026-08-26 that was 813s for 2,638 notes, so every run was
# killed before it could finish.
#
# The incremental bake landed instead of a larger number here: bodies are
# cached by file_cid, warm runs measure 50s, and 15m now bounds a COLD run
# (empty cache, first boot, or a cache someone deleted) with room to spare
# rather than bounding the steady state.
#
# Re-derive: `time python3 scripts/build_channel.py` — it prints its own note
# count. Both numbers above came from that and nothing else, which is the
# point: the ones they replaced had no way to be checked and so were never
# checked as the ledger grew past them.
TimeoutStartSec=15m

{
  "manifest": "emem-functions",
  "version": "v0",
  "_note": "Each function declares (a) which upstream sources it requires by canonical scheme, (b) how to derive the band value, (c) determinism guarantees. Source URL patterns live in source-connector manifests, not here — schemes are abstract.",
  "functions": [
    {
      "key": "nv.l2a@1",
      "kind": "primary",
      "out_band": "indices",
      "out_index": 0,
      "out_unit": "ratio",
      "sources": [
        { "scheme": "sentinel2.l2a", "channels": ["B04", "B08"], "tempo": "fast" }
      ],
      "formula": "(b08 - b04) / (b08 + b04)",
      "deterministic": true
    },
    {
      "key": "ev.l2a@1",
      "kind": "primary",
      "out_band": "indices",
      "out_index": 1,
      "out_unit": "ratio",
      "sources": [
        { "scheme": "sentinel2.l2a", "channels": ["B02", "B04", "B08"], "tempo": "fast" }
      ],
      "formula": "2.5 * (b08 - b04) / (b08 + 6*b04 - 7.5*b02 + 1)",
      "deterministic": true
    },
    {
      "key": "nw.l2a@1",
      "kind": "primary",
      "out_band": "indices",
      "out_index": 2,
      "out_unit": "ratio",
      "sources": [
        { "scheme": "sentinel2.l2a", "channels": ["B03", "B08"], "tempo": "fast" }
      ],
      "formula": "(b03 - b08) / (b03 + b08)",
      "deterministic": true
    },
    {
      "key": "sl.dem@1",
      "kind": "primary",
      "out_band": "terrain_derived",
      "out_index": 0,
      "out_unit": "degrees",
      "sources": [{ "scheme": "copernicus.dem.30m", "tempo": "static" }],
      "formula": "horn_1981_slope(3x3_window)",
      "deterministic": true
    },
    {
      "key": "as.dem@1",
      "kind": "primary",
      "out_band": "terrain_derived",
      "out_index": 1,
      "out_unit": "degrees",
      "sources": [{ "scheme": "copernicus.dem.30m", "tempo": "static" }],
      "formula": "horn_1981_aspect(3x3_window)",
      "deterministic": true
    },
    {
      "key": "tp.dem@1",
      "kind": "primary",
      "out_band": "terrain_derived",
      "out_index": 2,
      "out_unit": "meters",
      "sources": [{ "scheme": "copernicus.dem.30m", "tempo": "static" }],
      "formula": "tpi_3x3_mean_diff",
      "deterministic": true
    },
    {
      "key": "lc.esa@1",
      "kind": "primary",
      "out_band": "landcover",
      "out_unit": "one_hot_8",
      "sources": [{ "scheme": "esa.worldcover.v200", "tempo": "slow" }],
      "formula": "esa_class_to_8dim_onehot",
      "deterministic": true
    },
    {
      "key": "pp.ghsl@1",
      "kind": "primary",
      "out_band": "population",
      "out_unit": "people_per_km2",
      "sources": [{ "scheme": "ghsl.r2023a.pop", "tempo": "slow" }],
      "formula": "direct_read_density",
      "deterministic": true
    },
    {
      "key": "nl.viirs@1",
      "kind": "primary",
      "out_band": "nightlights",
      "out_unit": "nW_per_cm2_per_sr",
      "sources": [{ "scheme": "viirs.dnb.monthly", "tempo": "medium" }],
      "formula": "monthly_composite",
      "deterministic": true
    },
    {
      "key": "kg.koppen@1",
      "kind": "primary",
      "out_band": "koppen",
      "out_unit": "one_hot_32",
      "sources": [{ "scheme": "beck.koppen.2018", "tempo": "static" }],
      "formula": "32_class_lookup",
      "deterministic": true
    },
    {
      "key": "sr.soil@1",
      "kind": "primary",
      "out_band": "soilgrids",
      "out_unit": "vector_20",
      "sources": [{ "scheme": "soilgrids.v2.0", "tempo": "slow" }],
      "formula": "bilinear_resample_to_10m",
      "deterministic": true
    },
    {
      "key": "gt.slice@1",
      "kind": "primary",
      "out_band": "geotessera",
      "out_unit": "embedding_128",
      "sources": [{ "scheme": "geotessera.v1", "tempo": "slow" }],
      "formula": "direct_slice",
      "deterministic": true
    },
    {
      "key": "s2.comp@1",
      "kind": "primary",
      "out_band": "sentinel2_raw",
      "out_unit": "reflectance_10band",
      "sources": [{ "scheme": "sentinel2.l2a", "channels": ["B02","B03","B04","B05","B06","B07","B08","B8A","B11","B12"], "tempo": "fast" }],
      "formula": "monthly_median_composite",
      "deterministic": true
    },
    {
      "key": "s1.comp@1",
      "kind": "primary",
      "out_band": "sentinel1_raw",
      "out_unit": "backscatter_db_vv_vh",
      "sources": [{ "scheme": "sentinel1.grd.iw", "channels": ["VV", "VH"], "tempo": "fast" }],
      "formula": "monthly_mean_composite",
      "deterministic": true
    },
    {
      "key": "nd.delta@1",
      "kind": "derivative",
      "out_band": "indices",
      "out_index": 0,
      "op": "delta",
      "parents_required": 2,
      "formula": "value_b - value_a",
      "deterministic": true
    },
    {
      "key": "nd.trend@1",
      "kind": "derivative",
      "out_band": "indices",
      "out_index": 0,
      "op": "trend",
      "parents_min": 3,
      "formula": "ols_slope_per_month",
      "deterministic": true
    },
    {
      "key": "abs.s1.water@1",
      "kind": "negative",
      "out_band": "surface_water",
      "sources": [{ "scheme": "sentinel1.grd.iw", "channels": ["VV"], "tempo": "fast" }],
      "formula": "vv_max_below_threshold(-17_db)_implies_absence",
      "deterministic": true,
      "reason_template": "absence.confirmed_by:s1_scene_cid:{scene_cid}"
    },
    {
      "key": "open_meteo_copdem90m@1",
      "kind": "primary",
      "out_band": "cop_dem",
      "out_index": 0,
      "out_unit": "meters",
      "sources": [{ "scheme": "open_meteo", "channels": ["elevation"], "tempo": "static" }],
      "formula": "open_meteo_elevation_endpoint(latitude,longitude) → first_value; ocean (==0m) and upstream-no-coverage signed as Absence (scalar_key copdem30m.elevation_mean). DEPRECATED 2026-05-29 in favour of copernicus_dem_30m_aws_pixel@1; kept in the registry so receipts already signed under this key continue to verify.",
      "deterministic": true
    },
    {
      "key": "copernicus_dem_30m_aws_pixel@1",
      "kind": "primary",
      "out_band": "cop_dem",
      "out_index": 0,
      "out_unit": "meters",
      "sources": [{ "scheme": "copernicus.dem.30m.aws", "channels": ["elevation"], "tempo": "static" }],
      "formula": "copernicus_dem_glo30_cog_pixel(lat,lng) → sample of `copernicus-dem-30m.s3.amazonaws.com/Copernicus_DSM_COG_10_{lat_band}_00_{lng_band}_00_DEM.tif` at (world_x=lng, world_y=lat) via per-tile range-read; ocean (==0 / non-finite no-data) and tile 404 (no AWS tile published over open ocean or some Antarctic interiors) signed as Absence (scalar_key copdem30m.elevation_mean). Citation: Copernicus DEM GLO-30 — ESA / Copernicus Open Source mission. AWS Open Data Registry: arn:aws:s3:::copernicus-dem-30m. CC BY 4.0.",
      "deterministic": true
    },
    {
      "key": "met_no_locationforecast_compact@1",
      "kind": "primary",
      "out_band": "climate",
      "out_unit": "celsius/percent/mm/m_per_s",
      "sources": [{ "scheme": "met_no", "channels": ["air_temperature","cloud_area_fraction","precipitation_amount","wind_speed"], "tempo": "fast" }],
      "formula": "met_no_locationforecast_compact(lat,lng) → properties.timeseries[nearest_to(target_unix)].data.instant.details[field] for {temperature_2m, cloud_cover, precipitation_mm, wind_speed_10m}; one fact per scalar_key",
      "deterministic": true
    },
    {
      "key": "chirps.precip@1",
      "kind": "primary",
      "out_band": "chirps.precip_daily_mm",
      "out_index": 0,
      "out_unit": "mm/day",
      "sources": [{ "scheme": "chirps.daily.v2", "tempo": "fast" }],
      "formula": "chirps_v2_0_daily_cog_pixel(lat,lng,year,month,day) → mm/day (Float32, NoData=-9999.0); ±50° latitude clip, 1981-01-01 → today−30d coverage",
      "deterministic": true
    },
    {
      "key": "worldpop_wpgppop_v1_stats@1",
      "kind": "primary",
      "out_band": "population",
      "out_unit": "people_per_km2",
      "sources": [{ "scheme": "worldpop.global.1km", "tempo": "slow" }],
      "formula": "worldpop_stats_api(dataset=wpgppop,year,geojson=aoi_polygon(lat,lng,1km²)) → data.total_population; persons integrated over the 1 km² window equals people·km⁻² for the AOI. Citation: WorldPop Global per-country 100 m, Tatem 2017 (DOI:10.1038/sdata.2017.4). Data licence: CC BY 4.0. Rate-limited fallback path; prefer worldpop_wpgppop_cog_pixel@1.",
      "deterministic": true
    },
    {
      "key": "worldpop_wpgppop_cog_pixel@1",
      "kind": "primary",
      "out_band": "population",
      "out_unit": "people_per_km2",
      "sources": [{ "scheme": "worldpop.global.1km", "tempo": "slow" }],
      "formula": "cog_sample_pixel(data.worldpop.org/.../Global_2000_2020_1km_UNadj/{year}/{ISO3}/{iso3}_ppp_{year}_1km_Aggregated_UNadj.tif, lat, lng) → people·km⁻² (Float32, NoData≈-99999). ISO-3 resolved via countries::iso3_lower_for_point(lat,lng); years 2000..=2020. Citation: WorldPop Global per-country 100 m, Tatem 2017 (DOI:10.1038/sdata.2017.4). Data licence: CC BY 4.0.",
      "deterministic": true
    }
  ]
}
